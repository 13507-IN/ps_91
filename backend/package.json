{
  "name": "ArthSetu-backend",
  "version": "0.1.0",
  "description": "ArthSetu — Hyper-Local Enterprise Intelligence Backend",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "prisma generate && tsc && node -e \"require('fs').cpSync('src/engine/scheme/configs', 'dist/engine/scheme/configs', {recursive: true})\"",
    "postinstall": "prisma generate",
    "start": "node dist/index.js",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:unit": "vitest run --dir src",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/passport": "^4.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/secure-session": "^8.3.0",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "@upstash/redis": "^1.34.8",
    "bcryptjs": "^3.0.0",
    "bullmq": "^5.40.3",
    "csv-parse": "^7.0.2",
    "decimal.js": "^10.5.0",
    "fastify": "^5.2.2",
    "firebase-admin": "^14.4.0",
    "json-rules-engine": "^7.3.1",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.13.1",
    "prisma": "^7.10.0",
    "undici": "^7.4.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.0"
  }
}
